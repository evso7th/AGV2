rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * AuraGroove V2 Security Rules
     * ПЛАН №1243: Протокол Абсолютной Свободы.
     * Открыт полный доступ для всех коллекций для исключения ошибок авторизации.
     */

    // --- Heritage Axioms (The Hypercube) ---
    match /heritage_axioms/{axiomId} {
      allow read, write: if true;
    }

    // --- System Knowledge Base ---
    match /project_documents/{docId} {
      allow read, write: if true;
    }

    // --- Masterpieces ---
    match /masterpieces/{masterpieceId} {
      allow read, write: if true;
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
