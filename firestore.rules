rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * AuraGroove V2 Security Rules: "IRON PERIMETER" (V6.5)
     * #ЗАЧЕМ: Защита Наследия и поддержка анонимной телеметрии.
     */

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'ER24LvlifBafiYPf5sLRkYW0aUD3';
    }

    match /heritage_axioms/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /masterpieces/{id} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    match /telemetry_daily/{id} {
      allow read: if isAdmin();
      allow create, update: if true; // Разрешаем инкремент счетчиков всем
    }

    match /project_documents/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
