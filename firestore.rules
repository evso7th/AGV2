rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * AuraGroove V2 Security Rules: "IRON PERIMETER" (V5.5)
     * #ЗАЧЕМ: Защита Наследия и системных документов.
     * #КТО: Только владелец (Master UID) имеет право на изменение.
     */

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'ER24LvlifBafiYPf5sLRkYW0aUD3';
    }

    match /heritage_axioms/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /masterpieces/{id} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    match /project_documents/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}