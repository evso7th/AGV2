rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * AuraGroove V2 Security Rules
     * ВРЕМЕННОЕ РЕШЕНИЕ: Полный публичный доступ для всех коллекций.
     * #ЗАЧЕМ: Обеспечение бесперебойной работы DNA Auditor в режиме отладки.
     */

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
