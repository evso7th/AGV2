rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * AuraGroove V2 Security Rules: "OPEN FORGE" (V7.1)
     * #ЗАЧЕМ: Обеспечение публичной записи шедевров при сохранении контроля над Наследием.
     */

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'ER24LvlifBafiYPf5sLRkYW0aUD3';
    }

    // --- ЗОЛОТАЯ БАЗА (НАСЛЕДИЕ) ---
    match /heritage_axioms/{id} {
      allow read: if true;
      allow write: if isAuthenticated(); // Только для авторизованных операторов
    }
    
    // --- ШЕДЕВРЫ (ЛАЙКИ ПОЛЬЗОВАТЕЛЕЙ) ---
    match /masterpieces/{id} {
      allow read: if true;
      allow create: if true; // РАЗРЕШЕНО ВСЕМ: любой аноним может сохранить шедевр
      allow update, delete: if isAuthenticated(); // Модерация только для своих
    }

    // --- СИСТЕМНЫЕ СЕРВИСЫ ---
    match /telemetry_daily/{id} {
      allow read: if isAuthenticated();
      allow create, update: if true;
    }

    match /project_documents/{id} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /routes/{id} {
      allow read, write: if isAuthenticated();
    }

    // --- ГЛОБАЛЬНЫЙ ЗАЛОН ---
    match /{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}